# syntax=docker/dockerfile:1
# A self-hosted runner in a container: the `weft-runner` agent and the
# toolchain a workflow's `run:` steps usually assume, on Debian bookworm,
# as an unprivileged user. It is one way to run a runner, not the only
# one — the binary runs just as well straight on a build machine
# (docs/guide/self-hosted-runners.md) — and it is never part of the
# server deployment: runners go on machines you choose to run builds on.
#
#   docker build -f Dockerfile.runner -t weft-runner:local .
#
#   # once: exchange a registration token for this runner's credential,
#   # kept in a volume so restarts reuse it
#   docker run --rm -v weft-runner:/work/runner weft-runner:local \
#     register --url https://git.example.com --token weftg_… --dir /work/runner
#   # then: take jobs until stopped
#   docker run -d --restart unless-stopped --name weft-runner \
#     -v weft-runner:/work/runner weft-runner:local
#
# What is missing is deliberate. A runner executes shell out of somebody's
# repository, so everything in here is attack surface: no docker CLI or
# socket (a job that can talk to a daemon can escape its container), no
# cloud CLIs and no credentials. A job that needs more tools is a
# `FROM weft-runner:local` of your own.
#
# Corporate/CI proxies: pass a CA via `--secret id=extra_ca,src=…` and the
# predefined HTTP_PROXY/HTTPS_PROXY build args; absent, the steps no-op.

FROM rust:1.98-bookworm AS build
WORKDIR /src
RUN --mount=type=secret,id=extra_ca,required=false \
    if [ -s /run/secrets/extra_ca ]; then \
      mkdir -p /usr/local/share/ca-certificates \
      && cp /run/secrets/extra_ca /usr/local/share/ca-certificates/extra-ca.crt \
      && update-ca-certificates; fi
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    --mount=type=secret,id=extra_ca,required=false \
    cargo build --release -p stratum-runner \
    && cp target/release/weft-runner /weft-runner \
    && strip /weft-runner

FROM debian:bookworm-slim AS runtime
# git clones the tree; ca-certificates lets the fetch and the calls to the
# server verify TLS; curl/build-essential/python3/jq are what a workflow's
# `run:` steps assume exist without saying so. `bash` is already in the
# base image, and is named anyway because steps run under it. tini is
# PID 1: a long-running runner outlives many jobs, and whatever a step
# orphans has to be reaped by something.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       git bash ca-certificates curl build-essential python3 jq tini \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -u 10002 -m -d /work runner \
    && mkdir -p /work/runner \
    && chown -R runner:runner /work
COPY --from=build /weft-runner /usr/local/bin/weft-runner
USER runner
WORKDIR /work
# The runner's state (`.runner`, its credential, mode 0600) and its job
# working directories live under /work/runner; mount a volume there.
VOLUME ["/work/runner"]
# SIGTERM is a clean stop: the running job is killed and reported
# cancelled, then the runner exits 0. Give `docker stop -t` long enough.
STOPSIGNAL SIGTERM
# No HEALTHCHECK: the runner listens on nothing. It is healthy when the
# server lists it online (Settings → Runners).
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/weft-runner"]
CMD ["run", "--dir", "/work/runner"]
